<?xml version="1.0" encoding="UTF-8"?>
<!--
ソース名: manifest.xml
Lang: XML
Function: ローカル検証用（manifest.local.xml と同一内容の互換エイリアス）
Note: 手順書では manifest.local.xml を明示する。Id は他アドインと重複させないこと。
Author:Takashi Oikawa
Date:2026/04/03
LastUp:2026/04/04
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="TaskPaneApp">
  <Id>f3c2a891-5e4b-4d7c-8a6f-0c1d2e3f4a5b</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>DokoTsubu Demo</ProviderName>
  <DefaultLocale>ja-JP</DefaultLocale>
  <DisplayName DefaultValue="どこつぶ（デモ）"/>
  <Description DefaultValue="説明用モック: 投稿一覧のみ。認証・DB・シート操作なし。"/>
  <IconUrl DefaultValue="https://raw.githubusercontent.com/OfficeDev/Office-Add-in-samples/main/Samples/excel-tutorial/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://raw.githubusercontent.com/OfficeDev/Office-Add-in-samples/main/Samples/excel-tutorial/icon-80.png"/>
  <SupportUrl DefaultValue="https://github.com/OfficeDev/Office-Add-in-samples"/>
  <AppDomains>
    <AppDomain>http://localhost:3000</AppDomain>
  </AppDomains>
  <DefaultSettings>
    <SourceLocation DefaultValue="http://localhost:3000/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadDocument</Permissions>
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
</OfficeApp>
