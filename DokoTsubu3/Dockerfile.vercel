# Program Name: Dockerfile.vercel
# Language: Dockerfile
# Function: Build and run the DokoTsubu3 executable WAR on Java 21 for Vercel
# Created: 2026-10-04
# Last Updated: 2026-10-04
# Author: Takashi Oikawa
# AI: Cursor Grok 4.7
# Memo: The shell expands ${PORT} to a numeric --server.port. Context path remains /dokoTsubu from application.properties.

FROM maven:3.9.11-eclipse-temurin-21 AS build
WORKDIR /src
COPY pom.xml .
COPY src ./src
RUN mvn -B -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /src/target/dokotsubu-0.0.1-SNAPSHOT.war /app/dokotsubu.war
EXPOSE 8080
ENTRYPOINT ["sh", "-c", "exec java -jar /app/dokotsubu.war --server.port=${PORT}"]
